---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { depoimentos } from '../data/depoimentos';

// TODO: logos dos clientes (ART Mecânica, Protein Meal, Biobras) não vieram no kit.
// Quando chegarem, gere versões brancas monocromáticas em src/assets/clientes e
// preencha o campo `logo` em src/data/depoimentos.ts. Até lá, o nome da empresa é exibido em texto.
const destaque = depoimentos.find((d) => d.destaque)!;
const demais = depoimentos.filter((d) => !d.destaque);
---

<section id="clientes" aria-labelledby="clientes-titulo" class="bg-steel-950 py-16 md:py-24">
  <div class="container-site">
    <h2 id="clientes-titulo" class="h2 max-w-[24ch]" data-reveal>Indústrias que confiam a sua segurança à Miranda</h2>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        [destaque, ...demais].map((d) => (
          <article
            class:list={['card relative flex flex-col p-6 md:p-8', d.destaque && 'border-brand/60 lg:col-span-2 lg:p-10']}
            data-reveal
          >
            {d.destaque && <span class="hastes top-6 right-6" aria-hidden="true" />}
            <Icon name="quote" size={28} strokeWidth={1.5} class="text-brand" />
            <blockquote class:list={['mt-4 font-medium', d.destaque ? 'text-lg md:text-2xl md:leading-snug' : 'text-lg']}>
              <p>“{d.resumo}”</p>
            </blockquote>

            <div class="mt-6 flex flex-wrap items-end justify-between gap-4 border-t border-steel-800 pt-5">
              <div>
                <p class="font-display font-bold">{d.nome}</p>
                <p class="text-sm text-muted">
                  {d.cargo}, {d.empresa}
                  <br />
                  {d.cidade}
                </p>
              </div>
              <span class="font-display text-sm font-bold tracking-wide text-white/70">{d.empresa}</span>
            </div>

            <div class="mt-4">
              <button
                type="button"
                class="group inline-flex min-h-11 items-center gap-2 font-medium text-brand hover:text-white"
                aria-expanded="false"
                aria-controls={`depoimento-${d.id}`}
                data-acordeao
                data-rotulo-aberto="Recolher depoimento"
                data-rotulo-fechado="Ler depoimento completo"
              >
                <span data-rotulo>Ler depoimento completo</span>
                <Icon name="chevron-down" size={18} class="transition-transform duration-200 group-aria-expanded:rotate-180" />
              </button>
              <div id={`depoimento-${d.id}`} class="mt-3 space-y-3 text-muted" hidden>
                {d.completo.map((par, i) => (
                  <p>{i === 0 && '“'}{par}{i === d.completo.length - 1 && '”'}</p>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-12 gap-y-6 border-y border-steel-800 py-8" aria-label="Empresas atendidas">
      {
        depoimentos.map((d) => (
          <li class="font-display text-lg font-extrabold tracking-wide text-white opacity-70 transition-opacity hover:opacity-100">
            {d.empresa}
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center">
      <WhatsAppButton chave="depoimentos" secao="clientes">Quero o mesmo resultado na minha empresa</WhatsAppButton>
    </div>
  </div>
</section>
