---
import Icon from './Icon.astro';

const passos = [
  {
    icone: 'whatsapp',
    titulo: 'Chame no WhatsApp',
    texto: 'Envie a lista dos equipamentos. Fotos das placas de identificação aceleram o orçamento.',
  },
  { icone: 'file-text', titulo: 'Receba a proposta', texto: 'Escopo, prazo e valor por escrito.' },
  {
    icone: 'hard-hat',
    titulo: 'Inspeção em campo',
    texto: 'A equipe vai até você, na data combinada e com o cronograma respeitado.',
  },
  {
    icone: 'calendar-check',
    titulo: 'Documentação entregue',
    texto: 'Laudo, ART e relatório em formato digital, com o calendário dos próximos vencimentos.',
  },
] as const;
---

<section id="como-funciona" aria-labelledby="como-titulo" class="bg-steel-950 py-16 md:py-24">
  <div class="container-site">
    <h2 id="como-titulo" class="h2" data-reveal>Do primeiro contato ao laudo em 4 passos</h2>

    <div class="relative mt-12">
      <!-- Linha ciano que liga os passos: vertical no mobile, horizontal no desktop -->
      <span
        class="absolute top-6 bottom-6 left-6 w-0.5 bg-brand/70 lg:top-6 lg:right-[12.5%] lg:bottom-auto lg:left-[12.5%] lg:h-0.5 lg:w-auto"
        aria-hidden="true"></span>
      <ol class="relative grid gap-10 lg:grid-cols-4 lg:gap-8">
      {
        passos.map((p, i) => (
          <li class="relative grid grid-cols-[3rem_1fr] gap-x-5 lg:flex lg:flex-col lg:items-center lg:text-center" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <span class="relative z-10 flex size-12 items-center justify-center rounded-full border-2 border-brand bg-steel-950 text-brand">
              <Icon name={p.icone} size={22} />
            </span>
            <div class="lg:mt-6">
              <p class="font-display text-sm font-bold text-brand">Passo {i + 1}</p>
              <h3 class="mt-1 text-xl">{p.titulo}</h3>
              <p class="mt-2 text-muted lg:mx-auto lg:max-w-[26ch]">{p.texto}</p>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
