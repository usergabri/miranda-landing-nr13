---
import { iconesTraco, whatsappPath, type NomeIcone } from '../data/icones';

interface Props {
  name: NomeIcone;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: classe, strokeWidth = 1.75 } = Astro.props;
---

{
  name === 'whatsapp' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={classe} aria-hidden="true" focusable="false">
      <path d={whatsappPath} />
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={classe}
      aria-hidden="true"
      focusable="false"
      set:html={iconesTraco[name]}
    />
  )
}
