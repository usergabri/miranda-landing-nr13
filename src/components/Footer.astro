---
import { caminho } from '../data/caminho';
import logoPrincipal from '../assets/logo/logo-principal.svg';
import Divider from './Divider.astro';
import { site, ehMarcador } from '../data/site';
import { waAttrs } from '../data/whatsapp';

interface Props {
  /** Na página inicial os links são âncoras locais; nas demais, apontam para a home. */
  base?: string;
}
const { base = '' } = Astro.props;

const links = [
  { href: '#nr13', label: 'Inspeção NR-13' },
  { href: '#servicos', label: 'Outros serviços' },
  { href: '#como-funciona', label: 'Como funciona' },
  { href: '#clientes', label: 'Clientes' },
  { href: '#duvidas', label: 'Dúvidas' },
];
---

<footer class="bg-steel-950 pb-28 text-sm md:pb-10">
  <Divider withGear />
  <div class="container-site grid gap-10 pt-12 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <img src={logoPrincipal.src} alt="Miranda Engenharia" width="173" height="48" class="h-12 w-auto" loading="lazy" />
      <p class="mt-6 text-muted">
        {site.nome} · {site.cidade} ({site.uf}) · CNPJ {site.cnpj}
        <br />
        Responsável técnico CREA {site.creaResponsavel}
      </p>
    </div>

    <div>
      <p class="font-display text-base font-bold">Contato</p>
      <ul class="mt-4 space-y-2 text-muted">
        <li>
          WhatsApp:{' '}
          <a {...waAttrs('geral', 'rodape')} class="text-white underline-offset-2 hover:text-brand hover:underline">{site.whatsappExibicao}</a>
        </li>
        <li>
          E-mail:{' '}
          {
            ehMarcador(site.email) ? (
              <span class="text-white">{site.email}</span>
            ) : (
              <a href={`mailto:${site.email}`} class="text-white underline-offset-2 hover:text-brand hover:underline">
                {site.email}
              </a>
            )
          }
        </li>
      </ul>
    </div>

    <nav aria-label="Rodapé">
      <p class="font-display text-base font-bold">Serviços</p>
      <ul class="mt-4 space-y-2">
        {
          links.map((l) => (
            <li>
              <a href={base ? `${caminho(base)}${l.href}` : l.href} class="text-muted hover:text-brand">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={caminho('/politica-de-privacidade')} class="text-muted hover:text-brand">Política de Privacidade</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container-site mt-10">
    <p class="border-t border-steel-800 pt-6 text-muted">© 2026 Miranda Engenharia</p>
  </div>
</footer>
